<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PackageId>Cineverse.Infrastructure.WebApi</PackageId>
        <Version>2.0.5</Version>
        <Authors>Cineverse Team</Authors>
        <Company>Cineverse</Company>
        <Description>Infrastructure web api package</Description>
        <RepositoryUrl>https://github.com/DARK6870/Cineverse</RepositoryUrl>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <PackageOutputPath>..\nuget-packages</PackageOutputPath>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Cineverse.Auth" Version="1.0.5" />
      <PackageReference Include="Cineverse.Infrastructure.Common" Version="1.0.8" />
      <PackageReference Include="FluentValidation" Version="12.1.1" />
      <PackageReference Include="HotChocolate" Version="15.1.11" />
      <PackageReference Include="HotChocolate.AspNetCore" Version="15.1.11" />
      <PackageReference Include="HotChocolate.AspNetCore.Authorization" Version="15.1.11" />
      <PackageReference Include="HotChocolate.Data.MongoDb" Version="15.1.11" />
      <PackageReference Include="HotChocolate.Diagnostics" Version="15.1.11" />
      <PackageReference Include="MediatR" Version="14.0.0" />
      <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.0" />
      <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />
      <PackageReference Include="Microsoft.Extensions.DependencyModel" Version="10.0.1" />
      <PackageReference Include="Scalar.AspNetCore" Version="2.11.6" />
    </ItemGroup>

</Project>
